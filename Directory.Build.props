<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Treat repository C/C++ source files as UTF-8 in every Visual Studio configuration.
       This prevents MSVC C4819 when compiling Traditional Chinese comments and strings. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
